NODE_ENV=development
GAME_SERVER_PORT=3002
WINVERO_ORIGIN=http://127.0.0.1:5175
WINVERO_DATABASE_PATH=./data/winvero.sqlite
WINVERO_SESSION_TTL_SECONDS=604800
WINVERO_TEST_CREDITS_ENABLED=true
WINVERO_TRUST_PROXY=false
# Telegram notifications (production: set these explicitly).
# Local development also reads telegram-bot/.env when values are absent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
