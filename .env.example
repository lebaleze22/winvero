# Adresse locale du site servi par Docker Compose.
WINVERO_HTTP_PORT=8080
WINVERO_ORIGIN=http://localhost:8080
WINVERO_PUBLIC_URL=http://localhost:8080

# Le bot démarre avec les autres services lorsque ce jeton est renseigné.
# Obtenir le jeton auprès de BotFather. Ne pas le commiter.
TELEGRAM_BOT_TOKEN=
# Envoyer /whoami au bot après son premier démarrage, puis reporter l'identifiant ici.
TELEGRAM_ADMIN_CHAT_ID=
